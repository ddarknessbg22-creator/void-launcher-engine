<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- VOID is always AppCompat-based: every Zalith activity extends AppCompatActivity. -->
    <style name="Theme.VOID" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryDark">#FF000000</item>
        <item name="colorAccent">#FFFFFFFF</item>
    </style>

    <style name="Theme.VOID.Bootstrap" parent="Theme.VOID">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/void_splash</item>
    </style>

    <style name="Theme.VOID.Game" parent="Theme.VOID">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>
</resources>
